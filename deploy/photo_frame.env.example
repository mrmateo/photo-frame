LANG=C.UTF-8
LC_ALL=C.UTF-8

# Optional install path overrides
# APP_DIR=/opt/photo-frame
# CONFIG_PATH=/opt/photo-frame/config.json

# Optional display/platform overrides
# DISPLAY=:0
# XAUTHORITY=/home/pi/.Xauthority
# QT_QPA_PLATFORM=xcb

# Alternate platform examples
# QT_QPA_PLATFORM=wayland
# QT_QPA_PLATFORM=eglfs

# Optional app-level touch correction for displays where Qt receives
# touch coordinates rotated 180 degrees from the visible UI.
# PHOTO_FRAME_TOUCH_ROTATION=180
